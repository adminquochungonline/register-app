// Infrastructure pipeline for register-app (Azure).
// Provisions the platform with Terraform (azure/terraform):
//   - Resource Group
//   - Azure Container Registry (ACR)
//   - AKS cluster
//   - Kubelet AcrPull role assignment
//
// Flow: init/validate -> plan -> APPROVAL -> apply (or destroy).
//
// Required Jenkins credentials:
//   - azure-sp           (Username with password)  -> Service Principal appId/password
//   - azure-tenant       (Secret text)             -> Azure tenant ID
//   - azure-subscription (Secret text)             -> Azure subscription ID

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        choice(
            name: 'TF_ACTION',
            choices: ['plan-only', 'apply', 'destroy'],
            description: 'Terraform action. "apply"/"destroy" pause for approval after the plan.'
        )
        string(
            name: 'ENVIRONMENT',
            defaultValue: 'dev',
            description: 'Environment / name prefix (e.g. dev, prod).'
        )
        string(
            name: 'LOCATION',
            defaultValue: 'southeastasia',
            description: 'Azure region.'
        )
        string(
            name: 'NAME_SUFFIX',
            defaultValue: 'hung',
            description: 'Globally-unique suffix; registry = "<ENVIRONMENT>regapp<NAME_SUFFIX>".'
        )
        string(
            name: 'NODE_VM_SIZE',
            defaultValue: 'Standard_B2s',
            description: 'AKS node VM size. Standard_B2s or Standard_D2s_v5.'
        )
        string(
            name: 'NODE_COUNT',
            defaultValue: '1',
            description: 'Number of AKS nodes (1-5).'
        )
        booleanParam(
            name: 'MANAGE_ACR_PULL_ASSIGNMENT',
            defaultValue: true,
            description: 'Let Terraform grant AcrPull to the AKS kubelet identity.'
        )
        string(
            name: 'TFSTATE_STORAGE_ACCOUNT',
            defaultValue: 'hddevopsprojectstg001',
            description: 'Azure Storage account holding Terraform remote state (resource group tfstate-rg, container tfstate).'
        )
    }

    environment {
        INFRA_DIR = 'azure/terraform'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'terraform version'
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'azure-sp', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-tenant', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'azure-subscription', variable: 'ARM_SUBSCRIPTION_ID')
                ]) {
                    dir("${INFRA_DIR}") {
                        sh '''
                            set -e
                            export TF_VAR_environment="${ENVIRONMENT:-dev}"
                            export TF_VAR_location="${LOCATION:-southeastasia}"
                            export TF_VAR_name_suffix="${NAME_SUFFIX:-hung}"
                            export TF_VAR_node_vm_size="${NODE_VM_SIZE:-Standard_B2s}"
                            export TF_VAR_node_count="${NODE_COUNT:-1}"
                            export TF_VAR_manage_acr_pull_assignment="${MANAGE_ACR_PULL_ASSIGNMENT:-true}"

                            # Clean old state cache
                            rm -rf .terraform .terraform.lock.hcl terraform.tfstate terraform.tfstate.backup

                            # Backend initialization using Azure Storage
                            terraform init -input=false -reconfigure \
                              -backend-config="storage_account_name=${TFSTATE_STORAGE_ACCOUNT:-hddevopsprojectstg001}"
                            
                            terraform validate

                            if [ "${TF_ACTION}" = "destroy" ]; then
                                terraform plan -destroy -input=false -out=tfplan
                            else
                                terraform plan -input=false -out=tfplan
                            fi
                        '''
                    }
                }
            }
        }

        stage('Approval') {
            when {
                expression { return params.TF_ACTION == 'apply' || params.TF_ACTION == 'destroy' }
            }
            steps {
                script {
                    timeout(time: 30, unit: 'MINUTES') {
                        input(
                            message: "Review the Terraform plan above. Proceed with '${params.TF_ACTION}' on '${params.ENVIRONMENT}'?",
                            ok: "Yes, ${params.TF_ACTION}"
                        )
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { return params.TF_ACTION == 'apply' || params.TF_ACTION == 'destroy' }
            }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'azure-sp', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-tenant', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'azure-subscription', variable: 'ARM_SUBSCRIPTION_ID')
                ]) {
                    dir("${INFRA_DIR}") {
                        sh 'terraform apply -input=false -auto-approve tfplan'
                    }
                }
            }
        }

        stage('Output') {
            when { expression { return params.TF_ACTION == 'apply' } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'azure-sp', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-tenant', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'azure-subscription', variable: 'ARM_SUBSCRIPTION_ID')
                ]) {
                    dir("${INFRA_DIR}") {
                        sh '''
                            echo "=========================================="
                            echo "✅ Infrastructure provisioned successfully!"
                            echo "=========================================="
                            terraform output
                            echo "=========================================="
                            echo "Next step: Run the register-app-azure pipeline to deploy your application."
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Infrastructure pipeline completed successfully ('${params.TF_ACTION}') for '${params.ENVIRONMENT}'."
        }
        failure {
            echo "Infrastructure pipeline failed. Check stage logs above."
        }
    }
}
